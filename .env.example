# Copy to .env.local and fill in. Never commit real values.

# Supabase (phase 2). Local values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3417

# Dev only: show "To confirm" tags on unconfirmed shop details
NEXT_PUBLIC_SHOW_PLACEHOLDERS=true

# Online booking switch. Keep false until the owner confirms hours, durations and who does which service.
NEXT_PUBLIC_BOOKING_ENABLED=false

# Owner alert emails (Resend). Leave blank to switch emails off.
RESEND_API_KEY=
OWNER_ALERT_EMAIL=
ALERT_FROM_EMAIL=

# Web push alerts (VAPID). Leave blank to switch push off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Local backups only (npm run backup:prod)
BACKUP_DIR=
